# 拷成 .env 后按实际情况改。
# 这些值被 config.yaml 通过 os.environ/ 引用。

# ---- 上游：跑着 ds4-server 的那台机器 ----------------------------------------
# 换成你 Mac 的实际地址。局域网 IP、Tailscale IP、主机名都行。
# ds4-server 默认只监听 127.0.0.1，需要在那边用 DS4_HOST=0.0.0.0 起，
# 或用 socat 只把某个网络接口转出来（见 README「暴露 ds4-server」）。
DS4_API_BASE=http://YOUR_MAC_HOST:8000/v1
DS4_API_KEY=dsv4-local

# ---- 本地已有的其他模型（可选）-----------------------------------------------
# Ollama 默认: http://127.0.0.1:11434/v1
# vLLM  默认: http://127.0.0.1:8000/v1
QWEN_API_BASE=http://127.0.0.1:11434/v1
QWEN_API_KEY=none
QWEN_MODEL_ID=qwen3.6

# ---- 网关自身 ---------------------------------------------------------------
# 其他容器调用时用的 key。ds4-server 本身不做鉴权，这是补上的那一层。
LITELLM_MASTER_KEY=sk-change-me
LITELLM_PORT=4000
